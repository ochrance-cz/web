+function previewTarget(pathname: string): { url: string; frame?: HTMLIFrameElement } {
+	const documents = [document]
+	try {
+		if (window.parent !== window) documents.push(window.parent.document)
+	} catch { /* The host may be on another origin. */ }
+	for (const doc of documents) {
+		const frames = [...doc.querySelectorAll<HTMLIFrameElement>('iframe')]
+		const frame = frames.find(item => {
+			try { return new URL(item.src).hostname.startsWith('dev-') && new URL(item.src).hostname.endsWith('.nuasite.com') }
+			catch { return false }
+		})
+		if (frame) return { url: new URL(pathname, frame.src).href, frame }
+		const address = [...doc.querySelectorAll<HTMLInputElement>('input')].find(item => {
+			try { const host = new URL(item.value).hostname; return host.startsWith('dev-') && host.endsWith('.nuasite.com') }
+			catch { return false }
+		})
+		if (address) return { url: new URL(pathname, address.value).href }
+	}
+	return { url: new URL(pathname, window.location.href).href }
+}
