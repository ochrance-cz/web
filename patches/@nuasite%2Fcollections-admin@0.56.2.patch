@@ -0,0 +1,9 @@
+import type { CollectionDefinition } from '@nuasite/cms-types'
+
+// The editor's frequently used Czech collections come first; English stays
+// in its separate section. Collection IDs are stable when labels change.
+const frequent = ['aktualne', 'letaky', 'dokument', 'provoz-kontakty', 'zpravodaj', 'info106', 'alert']
+export function compareCzechCollections(a: CollectionDefinition, b: CollectionDefinition): number {
+	const rank = (name: string) => { const index = frequent.indexOf(name); return index < 0 ? frequent.length : index }
+	return rank(a.name) - rank(b.name) || a.label.localeCompare(b.label, 'cs') || a.name.localeCompare(b.name, 'cs')
+}
