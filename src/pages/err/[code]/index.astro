---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import matter from 'gray-matter';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { renderMarkdown } from '../../../lib/markdown';
import TextHeader from '../../../components/TextHeader.astro';

export function getStaticPaths() {
  return ['400', '404', '500'].map((code) => ({ params: { code } }));
}

const { code } = Astro.params;
const src = matter(readFileSync(join(process.cwd(), `src/sitedata/err/${code}.md`), 'utf8'));
const title = (src.data as { title?: string }).title ?? `Chyba ${code}`;
const body = await renderMarkdown(src.content);
---
<BaseLayout title={title} lang="cs">
  <main>
    <TextHeader title={title} locale="cs" />
    <section>
      <div set:html={body} />
    </section>
  </main>
</BaseLayout>
