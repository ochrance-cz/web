---
import PageHeader from '../../components/site-copy/headers/cs-info.astro';
import * as pageCopy0 from '../../components/page-content/section-pages/info.astro';
// /info/ — list of "Další informace" pages (cs). Ordered by `order`, then title.
import { getCollection } from 'astro:content';
import ListLayout from '../../layouts/ListLayout.astro';

const entries = (await getCollection('info'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => {
    const ao = a.data.order ?? Number.POSITIVE_INFINITY;
    const bo = b.data.order ?? Number.POSITIVE_INFINITY;
    if (ao !== bo) return ao - bo;
    return a.data.title.localeCompare(b.data.title, 'cs');
  });

const pages = entries.map((e) => ({
  title: e.data.title,
  href: `/info/${e.id}/`,
  perex: e.data.hp,
}));
import { data as section } from '../../components/page-content/section-pages/info.astro';
---
<ListLayout title={section.title} lang="cs" pages={pages} includeInSearchIndex={true} ><PageHeader slot="header" /></ListLayout>
