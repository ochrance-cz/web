---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPageEntries } from '../../../lib/page-content';
export async function getStaticPaths() {
  return (await getPageEntries('o-nas')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<BaseLayout title={entry.data.title} description={entry.data.description ?? entry.data.perex} lang="cs">
  <entry.Content />
</BaseLayout>
