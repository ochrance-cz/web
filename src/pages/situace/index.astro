---
import PageHeader from '../../components/site-copy/headers/cs-situace.astro';
import * as pageCopy0 from '../../components/page-content/section-pages/situace.astro';
// /situace/ — centered links to life situations with their annotations.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SituationList from '../../components/SituationList.astro';
import { renderMarkdown } from '../../lib/markdown';
import { url } from '../../lib/paths';
import { t } from '../../lib/i18n';

const terms = (await getCollection('situace')) ?? [];
terms.sort((a, b) => a.data.title.localeCompare(b.data.title, 'cs'));

const items = await Promise.all(
  terms.map(async (t) => ({
    href: url('cs', 'situace', t.id),
    title: t.data.title,
    perexHtml: t.data.perex ? await renderMarkdown(t.data.perex) : '',
  }))
);

const pageTitle = pageCopy0.data.title;
---
<BaseLayout title={pageTitle} lang="cs">
  <main>
    <PageHeader />
    <section>
      <nav aria-label="Zobrazení materiálů">
        <ul class="_horizontal-list">
          <li><a href={url('cs', 'situace')} class="selected" aria-current="page">{t('cs', 'handouts-by-sit')}</a></li>
          <li><a href={url('cs', 'letaky')}>{t('cs', 'handouts-all')}</a></li>
        </ul>
      </nav>
      <SituationList items={items} />
    </section>
  </main>
</BaseLayout>
