---
// News detail (cs). Mirrors layouts/aktualne/single.html:
// text-header (date + tags + description) → optional _backdrop overflow wrapper →
// section with gray pic, perex and editable article body →
// _no-print print + back-to-news block.
import { newsEntries } from '../../../lib/news';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TextHeader from '../../../components/TextHeader.astro';
import { renderMarkdown } from '../../../lib/markdown';
import { t } from '../../../lib/i18n';
import { nbspOneLetter, nbspOneLetterHtml } from '../../../lib/czech-nbsp';

export async function getStaticPaths() {
  const entries = newsEntries(await getCollection('aktualne', (e) => e.data.draft !== true), 'aktualne');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const lang = 'cs' as const;
const { entry } = Astro.props;
const { data } = entry;
// Pravidlo „jednopísmenkové slovo nezůstává na konci řádku“ platí jen pro tento jeden článek.
const nbspOnly = entry.id === 'kompostarna-zneprijemnila-zivot-lidem-v-okoli-ombudsmanka-se-zastala-muze-ktereho-stavebni-urad-neprizval-k-rizeni';
const fixText = (v: string) => (nbspOnly ? nbspOneLetter(v) : v);
const fixHtml = (v: string) => (nbspOnly ? nbspOneLetterHtml(v) : v);
const titleText = fixText(data.title);
const perexHtml = data.perex ? fixHtml(await renderMarkdown(data.perex)) : '';
const bodyHtml = data.body ? fixHtml(await renderMarkdown(data.body)) : '';
const illustration = data.illustration || undefined;
const illustrationAlt = data.illustrationAlt ?? '';
---
<BaseLayout title={data.title} lang={lang} description={data.perex} ogImage={illustration}>
  <main data-pagefind-body>
    <TextHeader
      title={titleText}
      date={data.date}
      tags={data.vystupy ?? []}
      description={(data as any).description}
      locale={lang}
    />

    <div class={illustration ? '_backdrop overflow' : undefined}>
      <section>
        {illustration && (
          <div class="img-wrapper">
            <img class="_gray-pic" src={illustration} alt={illustrationAlt} aria-hidden={illustrationAlt ? undefined : 'true'} />
          </div>
        )}

        <div class="perex" set:html={perexHtml} />

        {data.audio && (
          <div class="_no-print">
            {data.audioCaption && <p><strong>{data.audioCaption}</strong></p>}
            <p>
              <a class="_button" href={data.audio} download>{t(lang, 'download-audio')}</a>
            </p>
          </div>
        )}


        <div class="_ck4">
          <Fragment set:html={bodyHtml} />
        </div>

      </section>
    </div>

    <section class="_no-print">
      <p>
        <a href="#" onclick="window.print();">{t(lang, 'print')}</a>
      </p>
      <p>
        <a class="_button back" href="/aktualne/">{t(lang, 'back-to-news')}</a>
      </p>
    </section>
  </main>
</BaseLayout>
