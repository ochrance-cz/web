---
// News detail (en). Mirrors layouts/aktualne/single.html:
// text-header (date + tags + description) → optional _backdrop overflow wrapper →
// section with gray pic, perex and editable article body →
// _no-print print + back-to-news block.
import { newsEntries } from '../../../../lib/news';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TextHeader from '../../../../components/TextHeader.astro';
import { renderMarkdown } from '../../../../lib/markdown';
import { t } from '../../../../lib/i18n';

export async function getStaticPaths() {
  const entries = newsEntries(await getCollection('aktualne-en'), 'aktualne-en');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const lang = 'en' as const;
const { entry } = Astro.props;
const { data } = entry;
const perexHtml = data.perex ? await renderMarkdown(data.perex) : '';
const bodyHtml = data.body ? await renderMarkdown(data.body) : '';
const illustration = data.illustration || undefined;
---
<BaseLayout title={data.title} lang={lang} description={data.perex}>
  <main data-pagefind-body>
    <TextHeader
      title={data.title}
      date={data.date}
      tags={data.vystupy ?? []}
      description={(data as any).description}
      locale={lang}
    />

    <div class={illustration ? '_backdrop overflow' : undefined}>
      <section>
        {illustration && (
          <div class="img-wrapper">
            <img class="_gray-pic" src={illustration} alt="" aria-hidden="true" />
          </div>
        )}

        <div class="perex" set:html={perexHtml} />


        <div class="_ck4">
          <Fragment set:html={bodyHtml} />
        </div>

      </section>
    </div>

    <section class="_no-print">
      <p>
        <a href="#" onclick="window.print();">{t(lang, 'print')}</a>
      </p>
      <p>
        <a class="_button back" href="/en/aktualne/">{t(lang, 'back-to-news')}</a>
      </p>
    </section>
  </main>
</BaseLayout>
