---
// Document detail (en) — mirrors layouts/dokument/single.html.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TextHeader from '../../../../components/TextHeader.astro';
import MarkdownContent from '../../../../components/MarkdownContent.astro';
import { renderMarkdown } from '../../../../lib/markdown';

export async function getStaticPaths() {
  const entries = await getCollection('dokument-en');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;

const terms = await getCollection('vystupy-en');
const termTitle = new Map(terms.map((t) => [t.id, t.data.title as string]));
const tags = (data.vystupy ?? []).map((s) => termTitle.get(s) ?? s);

const perexHtml = data.perex ? await renderMarkdown(data.perex) : '';
---
<BaseLayout title={data.title} description={data.perex} lang="en">
  <main data-pagefind-body>
    <TextHeader title={data.title} date={data.date} tags={tags} locale="en" />

    <div>
      <section>
        {perexHtml && <div class="perex" set:html={perexHtml} />}

        <MarkdownContent content={entry.body} />

        {data.file && (
          <a href={data.file} class="_button">Download document</a>
        )}

      </section>
    </div>
  </main>
</BaseLayout>
