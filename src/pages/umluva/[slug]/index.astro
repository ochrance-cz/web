---
// /umluva/<slug>/ — single CRPD article. Mirrors Hugo layouts/umluva/single.html:
// title header + backlink to the listing, the raw-HTML body, prev/next nav, and the
// jPlayer that progressively enhances the .csc-frame-frame1 video blocks in the body.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MarkdownContent from '../../../components/MarkdownContent.astro';
import { sortArticles } from '../_articles';

export async function getStaticPaths() {
  const entries = sortArticles(await getCollection('umluva'));
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[i - 1] ?? null,
      next: entries[i + 1] ?? null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'umluva'>;
  prev: CollectionEntry<'umluva'> | null;
  next: CollectionEntry<'umluva'> | null;
}

const { entry, prev, next } = Astro.props;
---
<BaseLayout title={entry.data.title} lang="cs">
  <link
    href="/umluva-player/jplayer/skin/blue.monday/css/jplayer.blue.monday.min.css"
    rel="stylesheet"
    type="text/css"
  />
  <style is:global>
    .unavailable { color: #777; text-transform: uppercase; }
    .online-streaming { display: block; text-decoration: underline; text-transform: uppercase; }
    .icon-eye svg { fill: #008576; margin-bottom: 3px; }
    /* jPlayer */
    .jp-type-playlist { position: relative; }
    .jp-playlist li {
      background: none; text-indent: -5px;
      padding-left: 0.5rem !important; list-style-type: none !important;
    }
    .jp-playlist ul {
      height: 100% !important; max-height: 338px !important;
      overflow: auto; padding: 0px !important;
    }
    .jp-playlist a { display: block; padding: 5px 0; }
    .jp-playlist {
      position: absolute; right: -145px; top: 0; width: 140px; border-top: 0;
    }
    #video-wrap { margin-bottom: 2rem; }
    .csc-frame-frame1.active p { color: #008576; font-weight: bold; }
    #title-video { margin-top: 0; }
    #c1004628, #c1005443 { display: inline-block; }
    #c1004628 ul.csc-menu-1 li,
    #c1005443 ul.csc-menu-1 li { font-size: 1.5em; }
  </style>

  <main data-pagefind-body>
    <div class="_backdrop header">
      <header class="_text-header">
        <h1>{entry.data.title}</h1>
        <div class="perex">
          <p class="_umluva-backlink"><a href="/umluva/#obsah">zpět na obsah</a></p>
          <span class="" aria-hidden="true"></span>
        </div>
      </header>
    </div>

    <div>
      <section>
        <MarkdownContent content={entry.body} />

        {prev && (
          <a href={`/umluva/${prev.id}/`} class="_button back">{prev.data.title}</a>
        )}
        {next && (
          <a href={`/umluva/${next.id}/`} class="_button">{next.data.title}</a>
        )}
      </section>

      <script is:inline type="text/javascript" src="/umluva-player/mootools-core.js"></script>
      <script is:inline type="text/javascript" src="/umluva-player/jquery.min.js"></script>
      <script is:inline type="text/javascript" src="/umluva-player/jplayer/jplayer/jquery.jplayer.min.js"></script>
      <script is:inline type="text/javascript" src="/umluva-player/jplayer/add-on/jplayer.playlist.min.js"></script>
      <script is:inline type="text/javascript" src="/umluva-player/main.js"></script>
    </div>
  </main>
</BaseLayout>
