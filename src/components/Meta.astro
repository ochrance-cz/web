---
// SEO / Open Graph meta tags + language alternates.
interface Props {
  title: string;
  description?: string;
  lang?: 'cs' | 'en';
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  siteName?: string;
  /** hreflang alternates, e.g. [{ lang: 'en', href: '/en/...' }]. */
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description,
  lang = 'cs',
  canonical,
  ogImage,
  ogType = 'website',
  siteName = 'Ombudsman',
  alternates = [],
} = Astro.props;

const fullTitle = `${title} | Ombudsman`;
const ogLocale = lang === 'en' ? 'en_US' : 'cs_CZ';

// Social networks need absolute URLs; pages without their own image share the homepage hero.
const base = Astro.site ?? Astro.url;
const ogUrl = canonical ?? new URL(Astro.url.pathname, base).href;
const ogImageUrl = new URL(ogImage ?? (lang === 'en' ? '/images/og-default-en.jpg' : '/images/og-default.jpg'), base).href;
const ogImageAlt = ogImage ? fullTitle : lang === 'en'
  ? 'Ombudsman – Public Defender of Rights: Being here for everyone'
  : 'Ombudsman – veřejný ochránce práv: Pomáháme bez rozdílu';
---
{description && <meta name="description" content={description} />}
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={ogUrl} />
<meta property="og:image" content={ogImageUrl} />
{!ogImage && <meta property="og:image:width" content="1200" />}
{!ogImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.lang} href={alt.href} />
))}
