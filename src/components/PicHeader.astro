---
// Picture header (used by taxonomy / scope / leaflet listing pages).
interface Props {
  title: string;
  illustration?: string;
  headerColor?: string;
  alt?: string;
  /** When set, the title links to this URL. */
  href?: string;
}

const { title, illustration, headerColor = '', alt = '', href } = Astro.props;
---
<div class:list={['_backdrop', 'header', headerColor]}>
  <header class="_pic-header">
    <h1>{href ? <a href={href}>{title}</a> : title}</h1>

    {illustration && (
      <div class="single-hue-pic-wrapper">
        <div class="single-hue-pic">
          <img src={illustration} alt={alt} aria-hidden={alt ? undefined : 'true'} />
        </div>
      </div>
    )}
  </header>
</div>
