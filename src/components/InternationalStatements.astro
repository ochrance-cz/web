---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PicHeader from './PicHeader.astro';
import NewsPreview from './NewsPreview.astro';

interface Props { mode: 'type' | 'year' | 'all'; locale?: 'cs' | 'en' }
const { mode, locale = 'cs' } = Astro.props;
const copy = {
  cs: {
    title: 'Vyjádření pro mezinárodní orgány',
    category: 'vyjadreni-pro-mezinarodni-organy',
    nav: 'Zobrazení vyjádření',
    tabs: { type: 'Dle typu', year: 'Dle roku', all: 'Všechna vyjádření' },
    undated: 'Bez data',
  },
  en: {
    title: 'Statements to international bodies',
    category: 'statements-to-international-bodies',
    nav: 'Statement views',
    tabs: { type: 'By type', year: 'By year', all: 'All statements' },
    undated: 'Undated',
  },
}[locale];
const prefix = locale === 'en' ? '/en' : '';
const otherPrefix = locale === 'en' ? '' : '/en';
const typePath = (base: string, l: 'cs' | 'en') =>
  `${base}/vystupy/${l === 'en' ? 'statements-to-international-bodies' : 'vyjadreni-pro-mezinarodni-organy'}/`;
const hrefs = {
  type: typePath(prefix, locale),
  year: `${prefix}/vyjadreni-dle-roku/`,
  all: `${prefix}/vyjadreni-vse/`,
};
const translatedHref = mode === 'type'
  ? typePath(otherPrefix, locale === 'en' ? 'cs' : 'en')
  : `${otherPrefix}${hrefs[mode].slice(prefix.length)}`;
const collection = locale === 'en' ? 'dokument-en' : 'dokument';
const documents = (await getCollection(collection, (entry) => !('draft' in entry.data && entry.data.draft)))
  .filter((entry) => entry.data.vystupy?.includes(copy.category))
  .sort((a, b) => new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime());
const yearOf = (date: Date | undefined | null) => date ? String(new Date(date).getFullYear()) : copy.undated;
const groups = mode === 'type'
  ? ['CEDAW', 'OHCHR'].map((label) => ({ label, entries: documents.filter((entry) => entry.data.organ === label) }))
  : [...new Set(documents.map((entry) => yearOf(entry.data.date)))].map((label) => ({
      label, entries: documents.filter((entry) => yearOf(entry.data.date) === label),
    }));
const docHref = (id: string) => `${prefix}/dokument/${id}/`;
---
<BaseLayout title={copy.title} lang={locale} nav={{ translatedHref }}>
  <main data-pagefind-body>
    <PicHeader title={copy.title} />
    <section class="_news single-col">
      <nav aria-label={copy.nav}>
        <ul class="_horizontal-list">
          {(['type', 'year', 'all'] as const).map((tab) => (
            <li><a href={hrefs[tab]} class={mode === tab ? 'selected' : undefined} aria-current={mode === tab ? 'page' : undefined}>{copy.tabs[tab]}</a></li>
          ))}
        </ul>
      </nav>
      {mode === 'all' ? documents.map((entry) => (
        <NewsPreview href={docHref(entry.id)} title={entry.data.title} date={entry.data.date} tags={entry.data.vystupy} locale={locale} />
      )) : groups.filter((group) => group.entries.length).map((group) => (
        <section>
          <h2>{group.label}</h2>
          {group.entries.map((entry) => (
            <NewsPreview href={docHref(entry.id)} title={entry.data.title} date={entry.data.date} tags={entry.data.vystupy} locale={locale} />
          ))}
        </section>
      ))}
    </section>
  </main>
</BaseLayout>
