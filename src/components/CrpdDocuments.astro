---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PicHeader from './PicHeader.astro';
import Collapsible from './Collapsible.astro';
import NewsPreview from './NewsPreview.astro';
import { renderMarkdown } from '../lib/markdown';

interface Props {
  term: CollectionEntry<'vystupy'>;
  mode?: 'usneseni' | 'zapisy';
}
const { term, mode = 'usneseni' } = Astro.props;
const title = term.data.plural ?? term.data.title;
const perexHtml = term.data.perex ? await renderMarkdown(term.data.perex) : '';
const isMinute = (entry: CollectionEntry<'dokument'>) => /^Zápis\b/iu.test(entry.data.title);
const documents = (await getCollection('dokument', (entry) => !entry.data.draft))
  .filter((entry) => entry.data.vystupy?.includes('poradni-organ-crpd'))
  .filter((entry) => mode === 'zapisy' ? isMinute(entry) : !isMinute(entry))
  .sort((a, b) => new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime());
const yearOf = (entry: CollectionEntry<'dokument'>) => entry.data.date
  ? String(new Date(entry.data.date).getUTCFullYear()) : 'Bez data';
// Meeting dates are prose, not Markdown list markers ("16. prosince …").
const meetingPerex = (perex?: string) => perex?.trim().replace(
  /^(\s*\d+)\.(?=\s+(?:ledna|února|března|dubna|května|června|července|srpna|září|října|listopadu|prosince)(?:\s|$))/gmu,
  '$1\\.',
);
const years = [...new Set(documents.map(yearOf))].map((year) => ({
  year, entries: documents.filter((entry) => yearOf(entry) === year),
}));
---
<BaseLayout title={title} lang="cs">
  <main data-pagefind-body>
    <PicHeader title={title} illustration={term.data.illustration} />
    {perexHtml && <section class="perex crpd-section" set:html={perexHtml} />}
    <section class="_news single-col crpd-section">
      <nav aria-label="Zobrazení dokumentů poradního orgánu CRPD">
        <ul class="_horizontal-list">
          <li><a href="/vystupy/poradni-organ-crpd/" class={mode === 'usneseni' ? 'selected' : undefined} aria-current={mode === 'usneseni' ? 'page' : undefined}>Usnesení</a></li>
          <li><a href="/vystupy/poradni-organ-crpd/zapisy/" class={mode === 'zapisy' ? 'selected' : undefined} aria-current={mode === 'zapisy' ? 'page' : undefined}>Zápisy</a></li>
        </ul>
      </nav>
      {years.map(({ year, entries }, index) => (
        <Collapsible title={year} id={`crpd-${mode}-${year === 'Bez data' ? 'undated' : year}`} open={index === 0}>
          {entries.map((entry) => (
            <NewsPreview
              href={`/dokument/${entry.id}/`}
              title={entry.data.title}
              perex={meetingPerex(entry.data.perex)}
              date={entry.data.date}
              headingLevel={4}
              locale="cs"
            />
          ))}
        </Collapsible>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .crpd-section {
    margin: 3rem auto;
  }
</style>
