---
// Call-to-action backdrop (defaults to "submit a complaint").
import { t } from '../lib/i18n';

interface Props {
  title: string;
  text?: string;
  btnLink?: string;
  btnText?: string;
  locale?: 'cs' | 'en';
}

const { title, text, btnLink, btnText, locale = 'cs' } = Astro.props;
const link = btnLink || '/podejte-stiznost/';
const label = btnText || t(locale, 'submit-complaint');
---
<div class="_backdrop cta">
  <section>
    <h2>{title}</h2>
    {text && <p>{text}</p>}
    <p><a href={link} class="_button large">{label}</a></p>
  </section>
</div>
