---
import Contact from '../../Contact.astro';

// Page copy edited directly with Nua's live text and image editor.
export const data = { title: 'Podejte stížnost v českém znakovém jazyce' };
---
<main data-pagefind-body>
  <div class="_backdrop header">
    <header class="_text-header">
      <h1>Podejte stížnost v českém znakovém jazyce</h1>
    </header>
  </div>

  <section>
    <h2>Formou videa</h2>
    <p>Dejte nám vědět, pokud potřebujete odpověď v českém znakovém jazyce.</p>

    <Contact
      name="Robert Jungmann"
      email="robert.jungmann@ochrance.cz"
      phone="725 988 016"
      pic="https://cdn.nuasite.com/assets/ochrance-web-lj8h86/media/podejte-stiznost/czj/jungmann-02.jpg"
    />

    <h2>Osobně v Brně</h2>
    <p>Naše budova je přístupná. Podnět můžete podat osobně kterýkoli pracovní den.</p>
    <p><a class="_button" href="/pristupnost/budova/">Přístupnost budovy</a></p>
  </section>
</main>
