---
import Contact from '../../Contact.astro';

// Page copy edited directly with Nua's live text and image editor.
export const data = { title: 'Podejte stížnost v braillově písmu' };
---
<main data-pagefind-body>
  <div class="_backdrop header">
    <header class="_text-header">
      <h1>Podejte stížnost v braillově písmu</h1>
    </header>
  </div>

  <section>
    <h2>E-mailem</h2>
    <p>Dejte nám vědět, pokud potřebujete odpověď v Braillově písmu.</p>

    <Contact
      name="Romana Jakešová"
      email="romana.jakesova@ochrance.cz"
      pic="https://cdn.nuasite.com/assets/ochrance-web-lj8h86/media/podejte-stiznost/braille/jakesova-08.jpg"
    />

    <h2>Osobně v Brně</h2>
    <p>Naše budova je přístupná. Podnět můžete podat osobně kterýkoli pracovní den.</p>
    <p><a class="_button" href="/pristupnost/budova/">Přístupnost budovy</a></p>
  </section>
</main>
