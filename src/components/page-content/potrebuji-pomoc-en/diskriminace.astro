export const data = {
  "title": "I think I am being discriminated against",
  "perex": "The Anti-Discrimination Act stipulates specific areas in which unequal treatment is prohibited on grounds listed by the Act.",
  "hp": "Do you believe that someone is treating you differently because of your age, sex, nationality or on some other grounds specified by the Anti-Discrimination Act? Is it an authority, a company or local self-government that discriminate against you?",
  "order": 3
